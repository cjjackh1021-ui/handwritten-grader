# 可选：在此填写默认 API Key，网页留空时作为回退。
# 强烈建议直接在网页里填写 Key（仅内存传递、不落盘），不要长期存放在这里。

# 默认 provider：deepseek / openai / anthropic / custom
DEFAULT_PROVIDER=deepseek

# 各家默认 Key（留空即可，网页可覆盖）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 自定义 OpenAI 兼容服务（可选）
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Tesseract 可执行文件路径（留空则自动探测 PATH 与常见安装目录）
TESSERACT_CMD=

# LibreOffice/soffice 路径（用于 DOCX->PDF，留空则自动探测）
SOFFICE_CMD=

# 本地手写增强（初始化见 docs/handwriting.md）
HANDWRITING_OCR_MODE=hybrid
LOCAL_WORKER_IDLE_SECONDS=60
PADDLE_TIMEOUT=240
CHANDRA_TIMEOUT=240
HANDWRITING_TIMEOUT=60
CHANDRA_MIN_FREE_MB=10000
# 可覆盖组件解释器；留空使用项目独立环境
# PADDLE_PYTHON=
# CHANDRA_PYTHON=
# HANDWRITING_PYTHON=
